# Пример окружения учебного сервиса.
#
# ВНИМАНИЕ. Значения ниже — УЧЕБНЫЕ ЗАГЛУШКИ. Это не настоящие ключи и не
# настоящие пароли: они никуда не подходят и ни к чему не дают доступа.
# Они лежат здесь как ловушка: на них проверяются права агента в kilo.jsonc
# (задания 1.3.2–1.3.3), pre-commit хук и атаки на свои гардрейлы (дни 2–3).
#
# Правила:
#   * настоящие ключи в этот файл не вписывают — ни свои, ни чужие;
#   * рабочие значения живут в .env, а .env закрыт .gitignore;
#   * ключ OpenRouter живёт только в настройках Kilo Code, а не в репозитории.

APP_ENV=local
APP_DEBUG=1
APP_PORT=8080

DB_DSN="mysql:host=db;port=3306;dbname=carmoney_lab;charset=utf8mb4"
DB_USER=lab
DB_PASSWORD=lab
DB_PORT=3307

# УЧЕБНАЯ ЗАГЛУШКА, не настоящий ключ:
LAB_SOURCES_TOKEN=sk-lab-FAKE-0000000000000000000000000000000000000000

# УЧЕБНАЯ ЗАГЛУШКА, не настоящий пароль:
REPORTING_DB_PASSWORD=lab-demo-password-not-real
